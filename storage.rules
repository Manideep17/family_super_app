rules_version = '2';

// Family Super App — Cloud Storage rules (multi-tenant).
//
// Every uploaded asset lives under `families/{fid}/{kind}/{uid}/...`.
//
// WRITE is intentionally checked with uid ownership alone (`request.auth.uid
// == uid`, plus the content-type/size checks below) — no cross-service
// Firestore lookup. The path itself already scopes the write to the
// caller's own uid, so ownership is fully enforced without needing
// firestore.exists() to succeed. (A signed-in stranger could at most write
// into their own uid folder under a family they don't belong to; nothing
// in the app ever links to or displays that, since the corresponding
// Firestore doc write — which is what actually makes content visible — is
// separately gated by firestore.rules' real isMemberOf(fid) check. So this
// loses no real protection over family data, and gains not depending on
// Storage's cross-service rules feature working/being enabled for the
// exact operation — uploading — that most needs to be reliable.)
//
// READ still requires real family membership (via the Firestore lookup
// below), since that's the one property that actually needs enforcing here.

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMemberOf(fid) {
      return isSignedIn() && firestore.exists(
        /databases/(default)/documents/families/$(fid)/members/$(request.auth.uid)
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Limits: 25 MB images / audio, 200 MB video.
    function imageOk() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 25 * 1024 * 1024;
    }
    function videoOk() {
      return request.resource.contentType.matches('video/.*')
        && request.resource.size < 200 * 1024 * 1024;
    }
    function audioOk() {
      return request.resource.contentType.matches('audio/.*')
        && request.resource.size < 25 * 1024 * 1024;
    }

    // ---------- per-family asset paths ----------
    match /families/{fid}/avatars/{uid}/{allPaths=**} {
      allow read: if isMemberOf(fid);
      allow write: if isOwner(uid) && imageOk();
    }

    match /families/{fid}/vault/{uid}/{allPaths=**} {
      allow read: if isMemberOf(fid);
      allow write: if isOwner(uid) && (imageOk() || videoOk());
    }

    match /families/{fid}/stories/{uid}/{allPaths=**} {
      allow read: if isMemberOf(fid);
      allow write: if isOwner(uid) && (imageOk() || videoOk());
    }

    match /families/{fid}/chat_voice/{uid}/{allPaths=**} {
      allow read: if isMemberOf(fid);
      allow write: if isOwner(uid) && audioOk();
    }

    match /families/{fid}/reels/{uid}/{allPaths=**} {
      allow read: if isMemberOf(fid);
      allow write: if isOwner(uid) && videoOk();
    }

    match /families/{fid}/puzzle/{uid}/{allPaths=**} {
      allow read: if isMemberOf(fid);
      allow write: if isOwner(uid) && imageOk();
    }

    // Default-deny.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
