<?xml version="1.0" encoding="utf-8"?>
<!--
  "Embrace" mark: a larger rounded form (violet -> orchid gradient) with a
  smaller one (coral -> marigold gradient) nested into its corner, standing
  for one family member sheltering/being close to another — deliberately
  not tied to a specific family size or role. Both gradients use colors
  already in AppTheme.memberPalette (lib/core/theme/app_theme.dart), so the
  icon and the in-app per-member accent colors read as one family of color.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Back — larger rounded square, violet -> orchid -->
    <path android:pathData="M35,20 L55,20 A15,15 0 0 1 70,35 L70,55 A15,15 0 0 1 55,70 L35,70 A15,15 0 0 1 20,55 L20,35 A15,15 0 0 1 35,20 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="20" android:startY="20"
                android:endX="70" android:endY="70"
                android:startColor="#6D4CFF"
                android:endColor="#9D4EDD" />
        </aapt:attr>
    </path>
    <!-- Front — smaller rounded square nested into the back shape's corner, coral -> marigold -->
    <path android:pathData="M62,50 L74,50 A12,12 0 0 1 86,62 L86,74 A12,12 0 0 1 74,86 L62,86 A12,12 0 0 1 50,74 L50,62 A12,12 0 0 1 62,50 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="50" android:startY="50"
                android:endX="86" android:endY="86"
                android:startColor="#FF8A65"
                android:endColor="#FFC93C" />
        </aapt:attr>
    </path>
</vector>
