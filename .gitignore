# Cloud Functions (Node) — this was missing; `npm install`/`npm run build`
# in functions/ creates node_modules/ and lib/ which should never be
# committed (predeploy hook rebuilds them from source on every deploy).
**/node_modules/
functions/lib/
*.tsbuildinfo

# Owner analytics dashboard — config.js has a real Firebase web config +
# the owner's real email in allowedEmails; config.sample.js is the template
# that's meant to be committed instead.
owner_analytics_dashboard/config.js

# Cloudflare Wrangler cache — contains the linked Cloudflare account id/email.
worker/.wrangler/

